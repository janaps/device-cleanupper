<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device CleanUpper" Height="900" Width="1360"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen" MinHeight="720" MinWidth="1080">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="H1">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="Desc">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="Margin" Value="0,10,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <!-- borderless read-only TextBox that looks like a TextBlock but whose
             text can be selected + Ctrl+C copied (plain TextBlock can't in WPF) -->
        <Style TargetType="TextBox" x:Key="Copyable">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Cursor" Value="IBeam"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="MinWidth" Value="96"/>
        </Style>
        <!-- the one button on a step page that does the work: large and filled.
             Update-RunButton sets the colour: blue for read-only and dry-run
             steps, red when the click changes the tenant. -->
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#1A56C4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="28,12"/>
            <Setter Property="MinWidth" Value="300"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#D5D9DF"/>
                                <Setter Property="Foreground" Value="#5B6067"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="4"/><Setter Property="Margin" Value="0,0,0,2"/></Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="262"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- step rail -->
        <Border Grid.Column="0" Grid.RowSpan="4" Background="#1F2A3A">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Device CleanUpper" Foreground="White" FontSize="18"
                           FontWeight="Bold" Margin="18,20,18,2"/>
                <TextBlock DockPanel.Dock="Top" Text="release devices from this tenant" Foreground="#8FA3BC"
                           FontSize="11" Margin="18,0,18,12" TextWrapping="Wrap"/>
                <Border DockPanel.Dock="Bottom" x:Name="RailModeBox" Background="#16341E" Padding="14,10" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock x:Name="RailModeTitle" Text="DRY RUN" Foreground="#7EE787" FontWeight="Bold" FontSize="14"/>
                        <TextBlock x:Name="RailModeText" Text="Nothing is changed in the tenant."
                                   Foreground="#B9CBB9" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <ListBox x:Name="RailList" DockPanel.Dock="Top" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" Padding="14,8">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF"/>
                                            </Trigger>
                                            <!-- a page you cannot reach yet (Update-NavButtons) -->
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="26"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding StatusColor}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Number}" Foreground="#9FB2C8" FontSize="12"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{Binding Name}" Foreground="#E8EEF5" FontSize="13" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="#7E93AC" FontSize="10" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- page host -->
        <ScrollViewer Grid.Column="1" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="30,24">
            <Grid>
                <!-- ============================ Setup page ============================ -->
                <StackPanel x:Name="PageSetup">
                    <TextBlock Style="{StaticResource H1}" Text="Setup"/>
                    <TextBlock Style="{StaticResource Desc}">
                        Sign in as an administrator of the tenant the devices are leaving, pick a working folder,
                        and decide how careful this session should be. Everything is signed in as YOU - there is no
                        app registration and no certificate, so every change lands in the tenant audit log under
                        your own account.
                    </TextBlock>

                    <!-- sign in -->
                    <Border BorderBrush="#DADDE1" BorderThickness="1" CornerRadius="3" Background="#F6F8FA" Padding="14,12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Sign in" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,2"/>
                            <TextBox x:Name="SignInStatus" Style="{StaticResource Copyable}" FontSize="12" Foreground="#5B6067" Margin="0,0,0,8"
                                     Text="Not signed in."/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SignInBtn" Content="Sign in" MinWidth="130" FontWeight="SemiBold"/>
                                <Button x:Name="SignOutBtn" Content="Sign out" MinWidth="110"/>
                                <CheckBox x:Name="DeviceCodeCheck" Content="use a device code instead of the browser"
                                          VerticalAlignment="Center" Margin="14,0,0,0" Foreground="#555"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Tenant (optional)"/>
                            <!-- no HorizontalAlignment: a left-aligned TextBox sizes to its
                                 content, which for an empty box is no width at all -->
                            <TextBox x:Name="TenantBox"/>
                            <TextBlock Text="A tenant id or domain, so the sign-in cannot land in the wrong tenant by accident. Leave empty to use whatever you sign in with."
                                       Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,6"/>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Extra permissions to ask for"/>
                            <CheckBox x:Name="ScopeWipeCheck" Content="Wiping / retiring devices (step 3)" Margin="0,2,0,0"/>
                            <CheckBox x:Name="ScopeBitLockerCheck" Content="Reading BitLocker recovery keys (step 2)" Margin="0,4,0,0"/>
                            <TextBlock Text="These two are sensitive, so they are only requested when you tick them here. Change a tick after signing in and you have to sign in again."
                                       Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <TextBox x:Name="ScopeList" Style="{StaticResource Copyable}" FontSize="11" Foreground="#777" FontFamily="Consolas" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- safety -->
                    <Border x:Name="DryRunCard" BorderBrush="#A7D7B0" BorderThickness="1" CornerRadius="3" Background="#EAF7EE" Padding="14,12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock x:Name="DryRunTitle" Text="Dry run is ON" FontWeight="Bold" FontSize="14" Foreground="#1B5E20" Margin="0,0,0,4"/>
                            <CheckBox x:Name="DryRunCheck" IsChecked="True" FontWeight="SemiBold"
                                      Content="Dry run - report what would happen, change nothing"/>
                            <TextBox x:Name="DryRunText" Style="{StaticResource Copyable}" FontSize="12" Foreground="#33513A" Margin="22,4,0,0"
                                     Text="Every step still runs end to end and every device is still checked - only the delete, wipe and unassign calls are held back. Turn this off when the dry run looks right."/>
                        </StackPanel>
                    </Border>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="Working folder"/>
                    <DockPanel>
                        <Button x:Name="BrowseWorkBtn" DockPanel.Dock="Right" Content="Browse..." MinWidth="90"/>
                        <TextBox x:Name="WorkFolderBox"/>
                    </DockPanel>
                    <TextBlock x:Name="WorkFolderStatus" FontSize="12" Margin="0,2,0,0"/>
                    <TextBlock Text="Holds the device list (workingset.json), the exports and the audit log. Everything this tool does is appended to logs\devicecleanupper-&lt;date&gt;.log."
                               Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Warn about devices seen in the last"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="RecentDaysBox" Text="30" Width="60"/>
                                <TextBlock Text="days" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#555"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Style="{StaticResource FieldLabel}" Text=" "/>
                            <TextBox x:Name="RecentDaysHelp" Style="{StaticResource Copyable}" FontSize="12" Foreground="#5B6067"
                                     Text="A device that checked in or signed in more recently than this is almost certainly still in somebody's hands. Those rows are flagged in red, are never ticked automatically, and asking to delete them anyway needs an extra confirmation. Set 0 to switch the warning off."/>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="WindowsOnlyCheck" IsChecked="True" Margin="0,14,0,0"
                              Content="Only read Windows devices out of the tenant (faster - untick if the batch has iPads or Macs)"/>
                </StackPanel>

                <!-- ============================ Step page ============================ -->
                <StackPanel x:Name="PageStep" Visibility="Collapsed">
                    <TextBlock x:Name="StepTitle" Style="{StaticResource H1}"/>
                    <TextBox x:Name="StepDesc" Style="{StaticResource Copyable}" Foreground="#555" Margin="0,0,0,14"/>

                    <Border x:Name="StepBanner" Padding="12,9" CornerRadius="3" Margin="0,0,0,14" Background="#EEF0F3">
                        <TextBox x:Name="StepBannerText" Style="{StaticResource Copyable}" Foreground="#333" FontWeight="SemiBold" Background="Transparent"/>
                    </Border>

                    <!-- ===== section A: build the list (merged page 1 only) ===== -->
                    <Border x:Name="InputPanel" Visibility="Collapsed" BorderBrush="#DADDE1" BorderThickness="1"
                            CornerRadius="3" Background="#F6F8FA" Padding="12,10" Margin="0,0,0,6">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                <Border Width="24" Height="24" CornerRadius="12" Background="#1F2A3A" VerticalAlignment="Center">
                                    <TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="SectionAHeader" Text="First - put the devices on the list"
                                           FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBlock x:Name="SectionADone" Text="" Foreground="#1B7F35" FontWeight="SemiBold"
                                           FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="SectionAHint" Style="{StaticResource Copyable}" FontSize="12" Foreground="#5B6067"
                                     Margin="34,0,0,8"
                                     Text="Read them from a file, paste them in, type them in, or pick up a list you saved earlier. Nothing leaves this window yet."/>

                            <TabControl x:Name="InputTabs" BorderThickness="0" Background="Transparent">
                                <TabItem Header="  CSV / Excel file  ">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="File"/>
                                        <DockPanel>
                                            <Button x:Name="InFileBrowse" DockPanel.Dock="Right" Content="Browse..." MinWidth="90"/>
                                            <TextBox x:Name="InFilePath"/>
                                        </DockPanel>
                                        <TextBlock Text="A .csv (comma, semicolon or tab separated) or .xlsx file. Excel files are read directly - Excel does not have to be installed."
                                                   Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        <Expander Header="Sheet and column names (only needed when auto-detection gets it wrong)" Margin="0,10,0,0" Foreground="#444">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="Excel sheet" Foreground="#777" FontSize="11"/>
                                                    <TextBox x:Name="InFileSheet"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                    <TextBlock Text="serial column" Foreground="#777" FontSize="11"/>
                                                    <TextBox x:Name="InFileSerialCol"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                                    <TextBlock Text="device name column" Foreground="#777" FontSize="11"/>
                                                    <TextBox x:Name="InFileNameCol"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3">
                                                    <TextBlock Text="note column" Foreground="#777" FontSize="11"/>
                                                    <TextBox x:Name="InFileNoteCol"/>
                                                </StackPanel>
                                            </Grid>
                                        </Expander>
                                        <Button x:Name="InFileLoadBtn" Content="Read this file" HorizontalAlignment="Left"
                                                Margin="0,12,0,0" MinWidth="160" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </TabItem>

                                <TabItem Header="  Copy / paste  ">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Paste the devices here - one per line"/>
                                        <TextBlock Text="Works with a copy out of Excel, a portal table or a mail: serial numbers on their own, or serial and device name separated by a tab, semicolon, comma or a couple of spaces. A header line is recognised."
                                                   Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBox x:Name="InPasteBox" AcceptsReturn="True" AcceptsTab="True" Height="170"
                                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="InPasteLoadBtn" Content="Read this text" MinWidth="160" FontWeight="SemiBold" Margin="0"/>
                                            <Button x:Name="InPasteClipBtn" Content="Paste from clipboard" MinWidth="160"/>
                                            <Button x:Name="InPasteClearBtn" Content="Clear box"/>
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>

                                <TabItem Header="  Type them in  ">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Type or paste into the grid"/>
                                        <TextBlock Text="Fill in a serial number, a device name, or both. The last row is always empty - start typing in it to add another device."
                                                   Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <Border BorderBrush="#DADDE1" BorderThickness="1" CornerRadius="3" Background="White">
                                            <DataGrid x:Name="InManualGrid" AutoGenerateColumns="False" HeadersVisibility="Column"
                                                      CanUserAddRows="True" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                                                      Height="200" BorderThickness="0">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Serial number" Binding="{Binding Serial, UpdateSourceTrigger=PropertyChanged}" Width="1.2*"/>
                                                    <DataGridTextColumn Header="Device name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.2*"/>
                                                    <DataGridTextColumn Header="Note" Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Width="2*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button x:Name="InManualLoadBtn" Content="Add these rows" MinWidth="160" FontWeight="SemiBold" Margin="0"/>
                                            <Button x:Name="InManualClearBtn" Content="Clear grid"/>
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>

                                <TabItem Header="  Earlier list  ">
                                    <StackPanel Margin="0,10,0,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Pick up a list you saved before"/>
                                        <TextBlock Text="A workingset.json from a previous session (with everything that was already looked up and deleted), a devices-*.json export, or a devices-*.csv - a CSV only carries the identifiers, so run the lookup again after loading one."
                                                   Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <DockPanel>
                                            <Button x:Name="InWorkBrowse" DockPanel.Dock="Right" Content="Browse..." MinWidth="90"/>
                                            <TextBox x:Name="InWorkPath"/>
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button x:Name="InWorkLoadBtn" Content="Load this list" MinWidth="160" FontWeight="SemiBold" Margin="0"/>
                                            <Button x:Name="InWorkSaveBtn" Content="Save the list now"/>
                                        </StackPanel>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <CheckBox x:Name="InAppendCheck" IsChecked="True" VerticalAlignment="Center"
                                          Content="add to the list instead of replacing it" Foreground="#555"/>
                                <Button x:Name="InClearBtn" Content="Empty the list" Margin="18,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- the arrow between the two halves of the merged page -->
                    <TextBlock x:Name="SectionArrow" Visibility="Collapsed" Text="&#8595;" FontSize="20" Foreground="#9AA4B0"
                               HorizontalAlignment="Center" Margin="0,2,0,2"/>

                    <!-- ===== section B: everything the step itself does =====
                         On the merged page this is a numbered card; on every other
                         page Update-SectionChrome strips it back to a plain panel. -->
                    <Border x:Name="SectionB" BorderThickness="0" CornerRadius="3" Padding="0" Margin="0">
                        <StackPanel>
                            <StackPanel x:Name="SectionBHead" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,2">
                                <Border x:Name="SectionBBadge" Width="24" Height="24" CornerRadius="12" Background="#1F2A3A" VerticalAlignment="Center">
                                    <TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="SectionBHeader" Text="Then - look them up in the tenant"
                                           FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="SectionBHint" Style="{StaticResource Copyable}" Visibility="Collapsed" FontSize="12"
                                     Foreground="#5B6067" Margin="34,0,0,8"/>

                            <StackPanel x:Name="StepInfoPanel"/>

                            <!-- step options (built in code) -->
                            <StackPanel x:Name="StepOptionsPanel" Margin="0,4,0,0"/>

                            <!-- what will happen when Run is clicked -->
                            <Border x:Name="StepModeCard" Padding="14,12" CornerRadius="3" Margin="0,14,0,0"
                                    Background="#EAF7EE" BorderBrush="#A7D7B0" BorderThickness="1" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="StepModeTitle" Text="Dry run" FontWeight="Bold" Foreground="#1B5E20" Margin="0,0,0,4"/>
                                    <TextBox x:Name="StepModeText" Style="{StaticResource Copyable}" Foreground="#33513A" FontSize="13"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,18,0,4">
                                <Button x:Name="StepRunBtn" Content="Run this step" Style="{StaticResource PrimaryButton}" Margin="0"/>
                                <Button x:Name="StepRefreshBtn" Content="Refresh status" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ===== the device grid ===== -->
                    <StackPanel x:Name="DeviceGridPanel" Margin="0,18,0,0">
                        <DockPanel LastChildFill="False">
                            <TextBlock x:Name="GridHeader" Text="Devices" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                            <Button x:Name="GridNoneBtn" Content="Tick none" DockPanel.Dock="Right"/>
                            <Button x:Name="GridAllBtn" Content="Tick all" DockPanel.Dock="Right"/>
                            <Button x:Name="GridSafeBtn" Content="Tick only the safe ones" DockPanel.Dock="Right" MinWidth="170"/>
                            <Button x:Name="GridRemoveBtn" Content="Remove ticked from list" DockPanel.Dock="Right" MinWidth="160"/>
                        </DockPanel>
                        <Border BorderBrush="#DADDE1" BorderThickness="1" CornerRadius="3" Margin="0,6,0,0">
                            <DataGrid x:Name="DeviceGrid" AutoGenerateColumns="False" HeadersVisibility="Column"
                                      CanUserAddRows="False" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                                      MaxHeight="420" BorderThickness="0" IsReadOnly="False">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="34" SortMemberPath="Apply">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding Apply, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Device" Binding="{Binding Display}" Width="1.4*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Serial number" Binding="{Binding Serial}" Width="1.2*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Intune" Binding="{Binding IntuneState}" Width="1*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Autopilot" Binding="{Binding AutopilotState}" Width="1*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Entra ID" Binding="{Binding EntraState}" Width="1*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" Width="0.9*" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="Warning" Width="1.6*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Flag}" Foreground="{Binding FlagColor}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Flag}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Result" Width="1.6*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Result}" Foreground="{Binding ResultColor}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Result}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <TextBox x:Name="GridSummary" Style="{StaticResource Copyable}" FontSize="12" Foreground="#555" Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBlock Text="Activity" Style="{StaticResource FieldLabel}"/>
                    <Border BorderBrush="#DADDE1" BorderThickness="1" CornerRadius="3">
                        <ListBox x:Name="StepActivityList" Height="150" FontFamily="Consolas" FontSize="12" BorderThickness="0"
                                 SelectionMode="Extended"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <StackPanel x:Name="StepResultPanel" Margin="0,14,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- nav bar -->
        <Border Grid.Column="1" Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Padding="30,10">
            <DockPanel LastChildFill="False">
                <Button x:Name="BackBtn" Content="&#8592; Back" DockPanel.Dock="Left" Margin="0,0,4,0"/>
                <Button x:Name="NextBtn" Content="Next &#8594;" DockPanel.Dock="Left" FontWeight="SemiBold"/>
                <!-- why Next is greyed out (not signed in / not looked up yet) -->
                <TextBlock x:Name="NavHintText" DockPanel.Dock="Left" Visibility="Collapsed" VerticalAlignment="Center"
                           Margin="14,0,0,0" Foreground="#A25A00" FontWeight="SemiBold"/>
                <TextBox x:Name="StatusText" Style="{StaticResource Copyable}" AcceptsReturn="False" DockPanel.Dock="Left"
                         Margin="18,0,0,0" VerticalAlignment="Center" Foreground="#666"/>
                <CheckBox x:Name="VerboseCheck" Content="Verbose" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <Button x:Name="CancelBtn" Content="Cancel" DockPanel.Dock="Right" IsEnabled="False"/>
                <Border x:Name="NavModeBox" DockPanel.Dock="Right" Background="#EAF7EE" BorderBrush="#A7D7B0" BorderThickness="1"
                        CornerRadius="3" Padding="10,4" Margin="12,0,0,0">
                    <CheckBox x:Name="NavDryRunCheck" IsChecked="True" VerticalAlignment="Center" FontWeight="SemiBold">
                        <TextBlock x:Name="NavModeText" Text="Dry run - nothing is changed"/>
                    </CheckBox>
                </Border>
            </DockPanel>
        </Border>

        <!-- progress -->
        <StackPanel Grid.Column="1" Grid.Row="2" Margin="30,8,30,6">
            <TextBox x:Name="ProgressActivity" Style="{StaticResource Copyable}" AcceptsReturn="False" Foreground="#444" FontSize="12" Margin="0,0,0,2"/>
            <ProgressBar x:Name="OverallBar" Height="12" Minimum="0" Maximum="100" Margin="0,0,0,3"/>
            <ProgressBar x:Name="DetailBar" Height="7" Minimum="0" Maximum="100"/>
        </StackPanel>

        <!-- full log -->
        <Expander Grid.Column="1" Grid.Row="3" Header="Full log" Margin="30,0,30,10" IsExpanded="False">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="LogsBtn" Content="Open working folder" MinWidth="150" Margin="0"/>
                    <Button x:Name="CloseBtn" Content="Close"/>
                </StackPanel>
                <Border BorderBrush="#DADDE1" BorderThickness="1">
                    <ListBox x:Name="LogList" Height="170" FontFamily="Consolas" FontSize="12" BorderThickness="0"
                             SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" TextWrapping="NoWrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
        </Expander>
    </Grid>
</Window>
